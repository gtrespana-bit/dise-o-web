---
import Base from '../layouts/Base.astro';
const wa = encodeURIComponent('Hola, vengo de su web estudio boutique. Quisiera una auditoría privada para valorar encaje. Empresa:');
const waLink = `https://wa.me/584000000000?text=${wa}`;
---

<Base title="Estudio — Diseño Web y Plataformas para Negocios Premium" description="Estudio boutique en Venezuela y España. Webs que transmiten nivel premium y plataformas que escalan operación. VendeT Inmuebles y ReformaT en producción.">

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500&display=swap');
  .font-display { font-family: "Cormorant Garamond", serif; }
  .font-serif2 { font-family: "Instrument Serif", serif; }
  .font-sans2 { font-family: "Inter", sans-serif; }
</style>

<div class="bg-[#FDFCF9] text-[#121212] font-sans2 antialiased">

  <!-- HEADER -->
  <header class="sticky top-0 z-40 bg-[#FDFCF9]/90 backdrop-blur-xl border-b border-[#EAE4D9]">
    <div class="mx-auto max-w-[1440px] px-8 md:px-12 h-[72px] flex items-center justify-between">
      <div class="flex items-center gap-8">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-[#121212] text-white grid place-items-center font-serif2 text-[18px] leading-none">—</div>
          <div class="text-[12px] tracking-[0.2em] font-medium">ESTUDIO</div>
        </div>
        <nav class="hidden md:flex items-center gap-8 text-[11px] tracking-[0.18em] uppercase opacity-60">
          <a href="#obra" class="hover:opacity-100">Obra</a>
          <a href="#capacidad" class="hover:opacity-100">Capacidad</a>
          <a href="#metodo" class="hover:opacity-100">Método</a>
        </nav>
      </div>
      <a href={waLink} class="h-9 px-5 rounded-full bg-[#121212] text-white text-[12px] tracking-[0.06em] inline-flex items-center hover:bg-black transition">Auditoría privada</a>
    </div>
  </header>

  <!-- HERO -->
  <section class="mx-auto max-w-[1440px] px-8 md:px-12 pt-16 md:pt-28 pb-20 md:pb-28">
    <div class="grid lg:grid-cols-12 gap-12 md:gap-16">
      <!-- left 7 cols -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 text-[10px] tracking-[0.22em] uppercase font-mono border border-[#EAE4D9] rounded-full px-3 h-7 bg-white">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Disponible — 2 plazas Q2 2026
        </div>

        <h1 class="mt-10 font-display font-light text-[48px] md:text-[84px] leading-[0.9] tracking-[-0.04em]">
          Diseño web para<br/>
          negocios que no<br/>
          <span class="italic font-normal">compiten por precio.</span>
        </h1>

        <p class="mt-10 max-w-[52ch] text-[18px] leading-[1.6] font-light text-[#3A3935]">
          Estudio boutique en San Diego y Lanzarote para clínicas, inmobiliarias y reformas que facturan premium y no pueden permitirse verse genéricas. Webs de alto rendimiento y plataformas que escalan operación.
        </p>

        <div class="mt-10 flex gap-3">
          <a href={waLink} class="h-[48px] px-7 rounded-full bg-[#121212] text-white inline-flex items-center text-[13px] gap-2 hover:bg-black transition">Solicitar auditoría <span>→</span></a>
          <a href="#obra" class="h-[48px] px-7 rounded-full border border-[#EAE4D9] bg-white inline-flex items-center text-[13px] hover:bg-[#F5F0E8] transition">Ver obra</a>
        </div>

        <div class="mt-16 grid grid-cols-3 gap-8 max-w-[480px] border-t border-[#EAE4D9] pt-8">
          <div>
            <div class="font-display text-[36px] leading-none">2</div>
            <div class="mt-2 text-[11px] leading-[1.4] uppercase tracking-[0.12em] opacity-50">Marketplaces<br/>Supabase + S3 + RLS</div>
          </div>
          <div>
            <div class="font-display text-[36px] leading-none">80+</div>
            <div class="mt-2 text-[11px] leading-[1.4] uppercase tracking-[0.12em] opacity-50">Landings locales<br/>SEO · 98 Lighthouse</div>
          </div>
          <div>
            <div class="font-display text-[36px] leading-none">30+</div>
            <div class="mt-2 text-[11px] leading-[1.4] uppercase tracking-[0.12em] opacity-50">Negocios locales<br/>VE · ES · US</div>
          </div>
        </div>
      </div>

      <!-- right 5 cols image -->
      <div class="lg:col-span-5">
        <div class="relative rounded-[20px] overflow-hidden bg-[#F5F0E8] border border-[#EAE4D9] aspect-[4/5]">
          <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1200&q=80&auto=format" class="absolute inset-0 w-full h-full object-cover" alt="Interior lujo" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <div class="rounded-[14px] bg-white/90 backdrop-blur-xl border border-white/50 p-4">
              <div class="flex justify-between items-center text-[10px] tracking-[0.16em] uppercase font-mono opacity-60"><span>VendeT Inmuebles — producción</span><span class="px-2 py-0.5 rounded-full bg-emerald-500 text-white">RLS ACTIVE</span></div>
              <div class="mt-3 font-display text-[18px] leading-[1.1]">Marketplace 13 tablas · S3 · Realtime</div>
              <div class="mt-2 text-[11px] leading-[1.5] opacity-60">Next.js 14 · Supabase SSR · 37 rutas · Sentry · PWA</div>
            </div>
          </div>
        </div>
        <div class="mt-4 text-[11px] font-mono tracking-[0.12em] uppercase opacity-40 text-center">San Diego, Carabobo — Lanzarote, ES — Est. 2023</div>
      </div>
    </div>
  </section>

  <!-- PROOF BAR -->
  <div class="border-y border-[#EAE4D9] bg-white">
    <div class="mx-auto max-w-[1440px] px-8 md:px-12 h-[56px] flex items-center justify-between gap-6 overflow-x-auto">
      <div class="text-[10px] tracking-[0.2em] uppercase font-mono opacity-40 whitespace-nowrap">Construido en producción:</div>
      <div class="flex items-center gap-3 text-[11px] font-mono whitespace-nowrap">
        <span class="px-3 h-7 rounded-full bg-[#121212] text-white inline-flex items-center">VendeT Inmuebles — 13 tablas RLS</span>
        <span class="px-3 h-7 rounded-full border border-[#EAE4D9] inline-flex items-center">Marketplace VZLA — Realtime chat</span>
        <span class="px-3 h-7 rounded-full border border-[#EAE4D9] inline-flex items-center">ReformaT — 80+ landings SEO 98</span>
        <span class="px-3 h-7 rounded-full border border-[#EAE4D9] inline-flex items-center">Presupuestos — Python PDF</span>
      </div>
    </div>
  </div>

  <!-- MANIFIESTO -->
  <section class="mx-auto max-w-[1440px] px-8 md:px-12 py-24 md:py-36">
    <div class="max-w-[1120px]">
      <div class="flex gap-4 items-center">
        <div class="h-[1px] w-12 bg-[#121212]"></div>
        <div class="text-[11px] tracking-[0.24em] uppercase font-mono opacity-40">Manifiesto</div>
      </div>
      <h2 class="mt-8 font-display font-light text-[36px] md:text-[64px] leading-[0.9] tracking-[-0.04em] max-w-[18ch]">
        Si cobras premium, no puedes verte como commodity.
      </h2>
      <div class="mt-16 grid md:grid-cols-3 gap-12 border-t border-[#EAE4D9] pt-12">
        <div>
          <div class="text-[11px] tracking-[0.18em] uppercase font-mono opacity-40">01 — Congruencia</div>
          <p class="mt-4 text-[15px] leading-[1.7] font-light text-[#3A3935]">Local premium, equipo premium, materiales premium. Luego web con plantilla genérica. El cliente de ticket alto detecta la incongruencia en 4 segundos y se va.</p>
        </div>
        <div>
          <div class="text-[11px] tracking-[0.18em] uppercase font-mono opacity-40">02 — Performance</div>
          <p class="mt-4 text-[15px] leading-[1.7] font-light text-[#3A3935]">ReformaT carga en 0.9s, 98 Lighthouse, imágenes 48KB vs 910KB. No es vanidad técnica. Es respeto por el tiempo de quien paga $1.800 por una reforma en El Trigal.</p>
        </div>
        <div>
          <div class="text-[11px] tracking-[0.18em] uppercase font-mono opacity-40">03 — Coste real</div>
          <p class="mt-4 text-[15px] leading-[1.7] font-light text-[#3A3935]">Un cliente/mes perdido por web genérica × $900 = $10.800/año por ahorrar $600. Sin contar el posicionamiento perdido en Google.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OBRA -->
  <section id="obra" class="bg-[#121212] text-[#FDFCF9] py-20 md:py-28">
    <div class="mx-auto max-w-[1440px] px-8 md:px-12">
      <div class="flex flex-wrap justify-between items-end gap-6 border-b border-white/10 pb-10">
        <h2 class="font-display font-light text-[40px] md:text-[64px] leading-[0.85] tracking-[-0.04em]">Obra seleccionada<br/><span class="italic opacity-60 text-[36px] md:text-[48px]">— producción</span></h2>
        <div class="max-w-[320px] text-[13px] leading-[1.6] opacity-60">Cada proyecto es repo público con código y deploy. El lujo se demuestra en la base de datos, no en Dribbble.</div>
      </div>

      <!-- VENDET FULL -->
      <a href="https://github.com/gtrespana-bit/vendet-inmuebles" target="_blank" class="mt-12 grid lg:grid-cols-12 gap-0 rounded-[24px] overflow-hidden bg-[#1A1A1A] border border-white/10 group">
        <div class="lg:col-span-7 relative min-h-[480px] md:min-h-[560px]">
          <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1400&q=80" class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:opacity-80 group-hover:scale-[1.02] transition duration-[1.2s]" alt="" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          <div class="absolute top-6 left-6 text-[10px] tracking-[0.18em] uppercase font-mono px-3 h-7 rounded-full bg-white text-black inline-flex items-center">Proyecto enorme · 2025-26</div>
          <div class="absolute bottom-6 left-6 right-6 flex gap-2 font-mono text-[10px]">
            <span class="px-3 h-6 rounded-full bg-black/60 backdrop-blur border border-white/20 text-white inline-flex items-center">13 tablas RLS</span>
            <span class="px-3 h-6 rounded-full bg-black/60 backdrop-blur border border-white/20 text-white inline-flex items-center">S3 Signed URL</span>
          </div>
        </div>
        <div class="lg:col-span-5 p-8 md:p-10 flex flex-col justify-between">
          <div>
            <div class="font-display text-[40px] leading-[0.9]">VendeT Inmuebles</div>
            <p class="mt-4 text-[14px] leading-[1.6] opacity-60">Marketplace inmobiliario completo. Publicación con S3 + Sharp, vista vw_propiedades_publicas, chat Realtime, admin moderación, destacados pagados, suscripciones, auditoría, PWA offline, Sentry.</p>
          </div>
          <div>
            <div class="mt-10 grid grid-cols-3 gap-4 border-t border-white/10 pt-6 font-mono text-[11px]">
              <div><div class="opacity-40 uppercase">Tablas</div><div class="mt-1 text-[16px] font-display">13 + RLS</div></div>
              <div><div class="opacity-40 uppercase">Rutas</div><div class="mt-1 text-[16px] font-display">37</div></div>
              <div><div class="opacity-40 uppercase">Storage</div><div class="mt-1 text-[16px] font-display">S3 48KB</div></div>
            </div>
            <div class="mt-8 text-[12px] tracking-[0.06em] border-b border-white/20 pb-2 inline-flex">Ver schema DB y código →</div>
          </div>
        </div>
      </a>

      <div class="mt-6 grid lg:grid-cols-2 gap-6">
        <a href="https://github.com/gtrespana-bit/Marketplace-vzla" target="_blank" class="rounded-[20px] bg-[#1E1E1E] border border-white/10 p-8 flex flex-col gap-8 hover:bg-[#222] transition">
          <div>
            <div class="text-[10px] tracking-[0.18em] uppercase font-mono opacity-40">Marketplace VZLA — General</div>
            <div class="mt-4 font-display text-[32px] leading-[0.9]">Marketplace para todo Venezuela</div>
            <p class="mt-3 text-[13px] leading-[1.6] opacity-60">Carros, tecnología, hogar. 8 categorías con marcas dinámicas, chat Realtime, créditos, verificación, tasa BCV, moderación automática, PWA TTL 7d.</p>
          </div>
          <div class="rounded-[12px] overflow-hidden aspect-[16/10] bg-[#2A2A2A] relative">
            <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1000&q=80" class="absolute inset-0 w-full h-full object-cover opacity-70" alt="" />
          </div>
        </a>
        <a href="https://github.com/gtrespana-bit/reformat-venezuela" target="_blank" class="rounded-[20px] bg-[#FDFCF9] text-[#121212] p-8 flex flex-col gap-8 border border-[#EAE4D9] hover:bg-white transition">
          <div>
            <div class="text-[10px] tracking-[0.18em] uppercase font-mono opacity-40">ReformaT Venezuela — SEO 98</div>
            <div class="mt-4 font-display text-[32px] leading-[0.9]">80+ landings que generan leads mientras duermes</div>
            <p class="mt-3 text-[13px] leading-[1.6] opacity-60">Sitemap prioridades Carabobo 0.95, IndexNow, check-images. Performance 98, PWA, viewTransitions.</p>
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div class="rounded-[12px] bg-[#121212] text-white p-4"><div class="font-mono text-[10px] opacity-40">Sitemap</div><div class="mt-1 font-display text-[20px]">0.95</div></div>
            <div class="rounded-[12px] bg-[#F5F0E8] border border-black/10 p-4"><div class="font-mono text-[10px] opacity-40">Landings</div><div class="mt-1 font-display text-[20px]">80+</div></div>
            <div class="rounded-[12px] bg-white border border-black/10 p-4"><div class="font-mono text-[10px] opacity-40">Perf</div><div class="mt-1 font-display text-[20px]">98</div></div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- CAPACIDAD -->
  <section id="capacidad" class="mx-auto max-w-[1440px] px-8 md:px-12 py-24 md:py-32">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <div class="text-[11px] tracking-[0.22em] uppercase font-mono opacity-40">Capacidad técnica</div>
        <h2 class="mt-6 font-display text-[40px] md:text-[56px] leading-[0.85] tracking-[-0.04em]">De landing 98<br/>a marketplace<br/><span class="italic opacity-60">13 tablas.</span></h2>
        <p class="mt-6 max-w-[36ch] text-[14px] leading-[1.7] opacity-60">Si puedo con RLS, S3 signed URLs y Realtime, tu landing boutique es la parte fácil. Entrego repo con schema, PROJECT.md y migraciones como en VendeT.</p>
        <a href="https://github.com/gtrespana-bit/vendet-inmuebles" target="_blank" class="mt-8 inline-flex h-10 px-5 rounded-full border border-[#EAE4D9] bg-white items-center text-[12px] gap-2 hover:bg-[#F5F0E8] transition">Ver DB schema →</a>
      </div>
      <div class="lg:col-span-7 grid gap-[1px] bg-[#EAE4D9] border border-[#EAE4D9] rounded-[20px] overflow-hidden">
        <div class="bg-white p-8 grid md:grid-cols-2 gap-8">
          <div>
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase opacity-40">VendeT · Stack producción</div>
            <div class="mt-6 space-y-3 text-[13px] font-mono">
              <div class="flex justify-between"><span class="opacity-40">Next.js</span><span>14 App Router</span></div>
              <div class="flex justify-between"><span class="opacity-40">Supabase</span><span>SSR + Realtime</span></div>
              <div class="flex justify-between"><span class="opacity-40">Storage</span><span>S3 + Sharp</span></div>
              <div class="flex justify-between"><span class="opacity-40">PWA</span><span>offline + push</span></div>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase opacity-40">ReformaT · Lead Gen</div>
            <div class="mt-6 space-y-3 text-[13px] font-mono">
              <div class="flex justify-between"><span class="opacity-40">Astro</span><span>5 · 98 Lighthouse</span></div>
              <div class="flex justify-between"><span class="opacity-40">SEO</span><span>80+ landings · IndexNow</span></div>
              <div class="flex justify-between"><span class="opacity-40">Python</span><span>ReportLab PDF · CYPE</span></div>
            </div>
          </div>
        </div>
        <div class="bg-[#FDFCF9] p-6 flex flex-wrap justify-between items-center gap-4">
          <div class="text-[11px] font-mono opacity-40">37 rutas · i18n · rate-limit · moderación · tasa BCV</div>
          <div class="flex gap-2"><span class="h-7 px-3 rounded-full bg-black text-white text-[11px] inline-flex items-center">Astro + Next.js</span><span class="h-7 px-3 rounded-full border border-[#EAE4D9] text-[11px] inline-flex items-center">Supabase RLS</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- METODO -->
  <section id="metodo" class="bg-[#F5F0E8] border-y border-[#EAE4D9] py-20 md:py-28">
    <div class="mx-auto max-w-[1440px] px-8 md:px-12">
      <div class="flex flex-wrap justify-between items-end gap-8">
        <h2 class="font-display text-[40px] md:text-[56px] leading-[0.85]">Método de obra<br/><span class="italic opacity-60">bien hecha, sin humo</span></h2>
        <div class="max-w-[340px] text-[13px] leading-[1.6] opacity-60">Como en ReformaT: diagnóstico, especificación correcta, ejecución supervisada, entrega con checklist. Repo privado, no dependencia.</div>
      </div>
      <div class="mt-16 grid md:grid-cols-4 gap-[1px] bg-[#EAE4D9] border border-[#EAE4D9] rounded-[20px] overflow-hidden">
        <div class="bg-white p-8">
          <div class="font-display text-[48px] leading-none opacity-10">01</div>
          <div class="mt-6 text-[14px] font-medium">Diagnóstico honesto</div>
          <p class="mt-3 text-[13px] leading-[1.6] opacity-60">Loom 10min con tu web, competencia y gaps. Te digo si necesitas web nueva o nada. Gratis.</p>
        </div>
        <div class="bg-white p-8">
          <div class="font-display text-[48px] leading-none opacity-10">02</div>
          <div class="mt-6 text-[14px] font-medium">Dirección de arte</div>
          <p class="mt-3 text-[13px] leading-[1.6] opacity-60">Moodboard, tipografías, fotos. Definimos si tu negocio debe verse boutique clínico o inmobiliario de lujo.</p>
        </div>
        <div class="bg-white p-8">
          <div class="font-display text-[48px] leading-none opacity-10">03</div>
          <div class="mt-6 text-[14px] font-medium">Build limpio</div>
          <p class="mt-3 text-[13px] leading-[1.6] opacity-60">Astro / Next.js, webp 48KB, sitemap priority, IndexNow, WhatsApp tracking. Base VendeT si escala.</p>
        </div>
        <div class="bg-[#121212] text-white p-8">
          <div class="font-display text-[48px] leading-none opacity-20">04</div>
          <div class="mt-6 text-[14px] font-medium">Lanzamiento</div>
          <p class="mt-3 text-[13px] leading-[1.6] opacity-60">Deploy Vercel, Search Console, PWA, medición de consultas. Repo + Loom mantenimiento.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ESTUDIO -->
  <section class="mx-auto max-w-[1440px] px-8 md:px-12 py-24 md:py-32 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-7">
      <h2 class="font-display text-[40px] md:text-[64px] leading-[0.85]">Estudio boutique.<br/><span class="italic opacity-60">2 plazas por trimestre.</span></h2>
      <p class="mt-8 max-w-[52ch] text-[15px] leading-[1.7] opacity-60">No somos agencia de volumen. Tomamos 2 proyectos por trimestre para mantener estándar europeo. Si buscas $250 en 3 días, hay mil opciones en Fiverr. Si tu ticket es $800+ y valoras congruencia, hablemos.</p>
      <div class="mt-12 flex gap-10 border-t border-[#EAE4D9] pt-8 max-w-[480px]">
        <div><div class="font-display text-[28px]">VE · ES</div><div class="mt-1 font-mono text-[10px] uppercase opacity-40">San Diego — Lanzarote</div></div>
        <div class="border-l border-[#EAE4D9] pl-10"><div class="font-display text-[28px]">2023 —</div><div class="mt-1 font-mono text-[10px] uppercase opacity-40">Boutique — repo privado</div></div>
      </div>
    </div>
    <div class="lg:col-span-5 rounded-[20px] bg-[#121212] text-white p-8">
      <div class="text-[11px] tracking-[0.18em] uppercase font-mono opacity-40">Filtro honesto</div>
      <div class="mt-6 space-y-4 text-[14px] leading-[1.6]">
        <div class="flex gap-3"><span class="opacity-40">✓</span><span>Negocio con local físico, ticket $500+ que sabe que cliente paga por confianza.</span></div>
        <div class="flex gap-3"><span class="opacity-40">✓</span><span>Valora diseño sobrio, rápido, que aparece en Google.</span></div>
        <div class="flex gap-3"><span class="opacity-30">✕</span><span class="opacity-60">Si buscas lo más barato en 72h, no somos tu estudio.</span></div>
      </div>
      <div class="mt-8 rounded-[14px] bg-white text-black p-5">
        <div class="font-display text-[18px] leading-[1.1]">1 cliente/mes perdido × $900 = $10.800/año por ahorrar $700.</div>
        <a href={waLink} class="mt-4 h-10 rounded-full bg-black text-white w-full grid place-items-center text-[12px]">Solicitar auditoría privada →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#121212] text-white py-24 md:py-36">
    <div class="mx-auto max-w-[1440px] px-8 md:px-12 text-center">
      <div class="inline-flex h-8 px-4 rounded-full border border-white/10 bg-white/5 items-center gap-2 text-[10px] tracking-[0.18em] uppercase font-mono"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Auditoría privada — Loom 10min — sin pitch</div>
      <h2 class="mt-10 font-display text-[48px] md:text-[84px] leading-[0.85] tracking-[-0.04em] max-w-[12ch] mx-auto">¿Tu web transmite el nivel que cobras?</h2>
      <p class="mt-6 max-w-[48ch] mx-auto text-[15px] leading-[1.6] opacity-60">Diagnóstico honesto primero, como en obra. Si encajamos, 2 plazas este trimestre.</p>
      <div class="mt-10 flex justify-center gap-3">
