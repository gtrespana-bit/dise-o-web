---
import Base from '../layouts/Base.astro';
const wa = encodeURIComponent('Hola, he revisado su portfolio técnico (VendeT + ReformaT). Me gustaría solicitar una auditoría de mi negocio para valorar si encajamos. Empresa:');
const waLink = `https://wa.me/584000000000?text=${wa}`;

const schemaCode = `// VendeT Inmuebles — schema real
TABLE inmuebles {
  id uuid PK
  usuario_id → perfiles.id
  titulo varchar
  operacion_id → operaciones.id
  tipo_id → tipos_inmueble.id
  precio numeric · moneda USD
  area_total · habitaciones · banos
  activo bool · visitas int
  slug text UNIQUE
}

VIEW vw_propiedades_publicas AS
  SELECT i.*,
    o.nombre AS operacion_nombre,
    t.nombre AS tipo_nombre,
    pi.url_imagen AS main_image_url
  FROM inmuebles i
  LEFT JOIN operaciones o ON i.operacion_id=o.id
  LEFT JOIN tipos_inmueble t ON i.tipo_id=t.id
  LEFT JOIN inmueble_imagenes pi
    ON pi.inmueble_id=i.id AND pi.es_portada=true

// Marketplace categorias.ts — 8 cats, campos dinámicos
const campoAnio = { label: 'Año', type: 'select' }
categoriasData.vehiculos.subs[0].marcas = 
  ['Toyota','Ford','BMW'...22 marcas]`;
